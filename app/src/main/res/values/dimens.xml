<?xml version="1.0" encoding="utf-8"?>
<!--
    间距与尺寸规范。

    只允许使用这几个刻度（4 的倍数），不要在布局里随手写 7dp、13dp 这种数字 ——
    那是界面看起来"不整齐"最常见的原因。

      4  —— 元素内部的紧凑间距
      8  —— 图标与文字之间
      12 —— 相关元素之间
      16 —— 屏幕边缘内边距
      24 —— 分组之间
      32 —— 大区块之间
-->
<resources>

    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_2xl">32dp</dimen>

    <!-- 圆角 -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">14dp</dimen>
    <dimen name="radius_lg">20dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- 描边宽度 -->
    <dimen name="stroke_hairline">1dp</dimen>
    <dimen name="stroke_regular">2dp</dimen>

    <!-- 字阶 -->
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_subtitle">16sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_display">34sp</dimen>
    <dimen name="text_alarm">46sp</dimen>

    <!-- 报警按钮 -->
    <dimen name="alarm_button_width">440dp</dimen>
    <dimen name="alarm_button_height">112dp</dimen>

</resources>
