<?xml version="1.0" encoding="utf-8"?>
<!--
    调试信息面板。

    刻意做得比状态胶囊更暗、更小、字距更紧 ——
    它是给验收和排障用的仪表，不是给用户看的界面，
    存在感越低越好（而且默认是隐藏的）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#B30B0B0D" />
    <corners android:radius="@dimen/radius_sm" />
    <stroke
        android:width="@dimen/stroke_hairline"
        android:color="@color/outline_variant" />
</shape>
