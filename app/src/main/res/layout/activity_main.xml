<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
     值守主界面
    ============================================================

    层级（从下到上）：
      1. 黑色底
      2. 相机预览            —— 铺满整屏，界面主体就是它
      3. 检测框浮层
      4. 监测区域浮层
      5. 状态胶囊 + 调试面板 —— 唯一的常驻 UI
      6. 温度警告横幅
      7. 错误提示
      8. 报警界面            —— 盖住一切

    ────────── 设计原则：界面要「退后」 ──────────
    （注：XML 注释里不能出现 ASCII 的连续连字符，所以分隔线用的是制表符 ─）
    这是一块盯着加油站入口的屏幕。任何装饰都是在挤占画面。
    所以：
      · 常驻 UI 只有左上角一颗胶囊，其余全部隐藏
      · 不用彩色，层次靠半透明深底 + 一根细描边
      · 诊断信息默认隐藏，需要时在设置里打开（它是仪表，不是界面）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        相机预览。
        app:scaleType="fitCenter" ：完整显示不裁切。
        ⚠️ 不能用 fillCenter：那样会裁掉画面边缘，
           而 M3 要在画面上框选监测区域 ——
           一旦裁切，"你框的位置"和"相机真实看到的位置"就对不上，会导致漏报。
    -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:scaleType="fitCenter" />

    <!-- 检测框浮层 -->
    <com.gasstation.guard.ui.DetectionOverlayView
        android:id="@+id/detectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 监测区域浮层：区域外压暗，长按 2 秒进入框选 -->
    <com.gasstation.guard.ui.RoiOverlayView
        android:id="@+id/roiOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        ============================================================
         状态胶囊 —— 主界面上唯一的常驻元素
        ============================================================

        信息量控制在两个词以内：一个状态点 + 一句话。
        详细数据（帧率、分辨率、间隔、闸门…）全部挪进下面的调试面板，
        因为它们对使用者毫无意义，只对排障有意义。

        长按 2 秒 = 打开设置（和框选、解除报警用的是同一个手势习惯）。
    -->
    <LinearLayout
        android:id="@+id/statusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/space_lg"
        android:background="@drawable/bg_status_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_sm">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_status_dot" />

        <TextView
            android:id="@+id/tvStatusPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="值守中"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvStatusSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text=""
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!--
        调试面板（默认隐藏，在设置里打开）。

        ⚠️ 它是验收和排障用的仪表，不是给使用者看的界面。
           正式交付前应该在设置里关掉 ——
           一块满屏绿字会让用户以为"这个软件很复杂 / 出问题了"。
    -->
    <TextView
        android:id="@+id/tvDiag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_debug_panel"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:padding="@dimen/space_md"
        android:text=""
        android:textColor="@color/on_surface_variant"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 温度警告横幅：降载/暂停时出现（禁止静默降级） -->
    <TextView
        android:id="@+id/tvThermalWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/space_lg"
        android:background="@drawable/bg_thermal_banner"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:padding="@dimen/space_md"
        android:textColor="@color/warning"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <!-- 错误提示（居中）：权限被拒 / 相机失败 / 系统抢占时显示 -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#E6141417"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="@dimen/space_xl"
        android:textColor="@color/danger"
        android:textSize="@dimen/text_subtitle"
        android:visibility="gone" />

    <!--
        ============================================================
         强制报警界面
        ============================================================

        ⚠️ 这一层刻意【不追求优雅】。
        它的唯一任务是把人从睡梦里拽起来，所以：
          · 保持全屏红色闪烁（不能改成"温和的提示"）
          · 唯一的关闭方式是长按 2 秒（不能加"点一下关闭"）
        这里做的只是"让它强烈得有设计感"，而不是"让它变温和"。
    -->
    <FrameLayout
        android:id="@+id/alarmOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/alarmFlash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/alarm" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAlarmTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="12"
                android:text="有车辆进入"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_alarm"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlarmSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text=""
                android:textColor="#F2FFFFFF"
                android:textSize="@dimen/text_subtitle" />

            <com.gasstation.guard.ui.LongPressConfirmButton
                android:id="@+id/btnImHere"
                android:layout_width="@dimen/alarm_button_width"
                android:layout_height="@dimen/alarm_button_height"
                android:layout_marginTop="@dimen/space_2xl" />
        </LinearLayout>

        <!-- 三条报警通道的实时状态。同样只在需要时看，做得轻 -->
        <TextView
            android:id="@+id/tvAlarmDiag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="#80000000"
            android:fontFamily="monospace"
            android:padding="@dimen/space_sm"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
