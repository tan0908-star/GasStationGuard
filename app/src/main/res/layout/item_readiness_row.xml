<?xml version="1.0" encoding="utf-8"?>
<!--
    就绪检查里的一行：状态标记 + 标题 + 「缺了会怎样」+ 处理按钮。

    刻意保留"缺了会怎样"这一行文字：
    只说「请授权相机」用户会跳过，说「没有它就没有画面，等于完全没在值守」
    他才会认真对待。授权请求必须带上后果。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <TextView
        android:id="@+id/tvMark"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemTitle"
            style="@style/Text.GasGuard.ItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="" />

        <TextView
            android:id="@+id/tvItemWhy"
            style="@style/Text.GasGuard.ItemHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="" />
    </LinearLayout>

    <Button
        android:id="@+id/btnFix"
        style="@style/Widget.GasGuard.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:minWidth="96dp"
        android:text="去处理" />

</LinearLayout>
