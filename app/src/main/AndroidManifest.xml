<?xml version="1.0" encoding="utf-8"?>
<!--
    应用清单：声明权限、声明 Activity、声明横屏锁定。
    整个项目里「系统能看见什么」都在这个文件写清楚。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 相机权限：M1 的预览、M2 的识别都依赖它。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 震动权限（M3）：报警时循环震动。必须和声音、语音同时上，
         任何一条通道失效另外两条还在。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 拨打电话权限（M3）：报警 30 秒无人解除时自动拨打紧急号码。
         这是最后一道防线 —— 如果人根本不在岗，光有声音没用。 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- 修改音频设置（M3）：报警时把闹钟音量强制拉到最大，结束后还原。
         不做这一步，"静音模式下报警没用"这个问题就解决不了。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ================= M4：后台常驻相关 ================= -->

    <!-- 前台服务（M4）：让进程保持前台优先级，避免被系统低内存杀手干掉。
         这是"8 小时不被杀"的第一道防线。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 14 起，前台服务必须声明【类型】的对应权限。
         我们用 specialUse 而不是 camera：
         因为 Android 15 起禁止从 BOOT_COMPLETED 启动 camera 类型的前台服务，
         specialUse 不在限制名单里，开机才能正常拉起。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 通知权限（M4）：Android 13 起是运行时权限。
         没有它，前台服务的常驻通知不显示，部分 ROM 会因此直接杀掉服务。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 接收开机广播（M4）：开机自启的入口 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 显示在其他应用上层（M4）：这是 Android 上【后台启动界面】的唯一可靠豁免。
         没有它，看门狗就拉不起值守界面，重启后无法自动恢复值守。
         需要在系统设置里手动授予，代码无法代劳。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 声明「本应用必须要有摄像头」。荣耀 200 有后置摄像头，满足。
         required="true" 意味着没有摄像头的设备装不上，
         这符合预期——没有相机的设备装它没有意义。 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GasStationGuard">

        <!--
            加油站夜班值守的主界面。

            screenOrientation="landscape"
                → 锁定横屏。手机固定横置在支架上，绝不允许画面自己旋转。
                  （Android 16 有「大屏强制忽略横竖屏锁定」的改动，但那条只对
                   最小宽度 ≥600dp 的设备生效；荣耀 200 的最小宽度约 400dp，
                   不受影响，横屏锁定依然有效。）

            configChanges="..."
                → 系统配置变化时不重建 Activity。
                  否则任何一次旋转/尺寸变化都会把相机整个重启一遍。

            launchMode="singleTask"
                → 桌面上重复点击图标不会产生第二个实例（两个实例会抢摄像头）。

            allowBackup="false"（在 application 上）
                → 彻底关闭系统云备份，保证「不上传任何数据」这条红线。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.GasStationGuard">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            值守前台服务（M4）。

            foregroundServiceType="specialUse" 是刻意的选择：
            Android 15 起禁止从 BOOT_COMPLETED 启动 camera 类型的前台服务，
            而 specialUse 不在限制名单里，开机自启才能走通。
            相机的合法性问题由"界面可见"来解决，不是靠服务类型。
        -->
        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="夜间值守监控：持续运行车辆检测并在检测到车辆时强制报警，用户已明确开启且界面常驻可见" />
        </service>

        <!--
            外部看门狗（M4 兜底）。
            exported="false"：这个广播只由我们自己的 PendingIntent 发出，
            不允许其它应用触发（否则任意应用都能反复拉起我们，白白耗电）。
        -->
        <receiver
            android:name=".service.WatchdogReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
            开机自启（M4）。
            exported="true" 是必须的：BOOT_COMPLETED 是系统发出的广播。
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
